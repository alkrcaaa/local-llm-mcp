# Copy this file to .env and fill in your own vLLM / OpenAI-compatible endpoint.
# Both vars are optional at the server level — you can also set them via the
# MCP client's own server config ("env" block) instead. Values there win over
# .env (python-dotenv defaults to override=False).

# Base URL of your OpenAI-compatible vLLM (or similar) server, including /v1.
QWEN_BASE_URL=http://localhost:8002/v1

# Exact model id as served by QWEN_BASE_URL. Leave unset to auto-detect the
# first model the server reports (see server.py::_model_id).
QWEN_MODEL=
